# Hugging Face Configuration
# Token opsional jika menggunakan model private atau batas rate limit lebih tinggi
HF_TOKEN=

# Model Configuration
MODEL_NAME=openai/clip-vit-base-patch32
DEVICE=cuda

# Detection Parameters
THRESHOLD=0.70
SHOW_DETAIL=True

# Dataset / Path Settings
FOLDER_PATH=folder_foto
IMAGE_PATH=foto_makanan.jpg

